# 复制为 .env 后按需修改。应用通过 python-dotenv 在加载 config 时读取。

# ---------- 数据库（默认 MySQL）----------
# 若出现 1045 Access denied：请在 MySQL 中创建用户并授权，或改 DATABASE_URL 为实际账号。
# 方式一：分项配置（未设置 DATABASE_URL 时使用）
MYSQL_USER=maps
MYSQL_PASSWORD=maps_dev
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=maps

# 连接池（可选）
# MYSQL_POOL_SIZE=10
# MYSQL_MAX_OVERFLOW=20

# 方式二：整串覆盖（优先级最高）
# DATABASE_URL=mysql+pymysql://maps:maps_dev@127.0.0.1:3306/maps?charset=utf8mb4

# 无 MySQL 的本地开发可改用 SQLite 文件：
# MAPS_USE_SQLITE=1

# ---------- 其他 ----------
# SECRET_KEY=
# REDIS_URL=redis://localhost:6379/0
