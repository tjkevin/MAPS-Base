# 复制为 .env 后按需修改。应用通过 python-dotenv 在加载 config 时读取；
# docker-compose 启动时也会自动读取本文件做变量替换。

# ---------- 数据库（默认 MySQL）----------
# 方式一：分项配置（未设置 DATABASE_URL 时使用）
MYSQL_USER=maps
MYSQL_PASSWORD=maps_dev
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=maps

# 连接池（可选）
# MYSQL_POOL_SIZE=10
# MYSQL_MAX_OVERFLOW=20

# 方式二：整串覆盖（优先级最高）
# DATABASE_URL=mysql+pymysql://maps:maps_dev@127.0.0.1:3306/maps?charset=utf8mb4

# 无 MySQL 的本地开发可改用 SQLite 文件：
# MAPS_USE_SQLITE=1

# ---------- Flask ----------
# SECRET_KEY 必填（生产/MySQL 部署缺失会启动失败）：openssl rand -hex 32 生成
# SECRET_KEY=
# SESSION_COOKIE_SECURE=false   # 上 HTTPS 后设为 true
# SESSION_COOKIE_SAMESITE=Lax  # 默认 Lax，一般无需修改

# ---------- Redis ----------
# REDIS_URL=redis://localhost:6379/0
# Redis密码（Docker部署时）
# REDIS_PASSWORD=

# ---------- 模型服务多后端（云端不跑模型，统一调用外部API）----------
# 默认后端：autodl(BAGEL满血版) | local(BAGEL优化版) | deepseek(纯文本) | auto(自动路由)
# auto = 纯文本任务走deepseek、图片/媒体理解走 MODEL_DEFAULT_GPU_BACKEND
# MODEL_DEFAULT_BACKEND=auto
# auto路由时图片/媒体任务默认GPU端点：autodl | local
# MODEL_DEFAULT_GPU_BACKEND=local

# ① autoDL：BAGEL SFT 满血版（autodl_api/serve_api.py，单图 VQA；sft_nf4/sft_bf16 两形态）
#   协议 autodl_v1：GET /health（免鉴权，waiting_gpu/loading/ready/error）+ POST /v1/infer（Bearer，JSON base64）
#   网络三选一（详见 docs/AutoDL对接配置说明-20260903.md）：
#   - 方案B SSH反向隧道【推荐生产】：AutoDL 上 autossh -R 0.0.0.0:18080:127.0.0.1:6006 连到本机，
#     容器内填 http://host.docker.internal:18080（compose 已配 extra_hosts: host-gateway）
#   - 方案A AutoDL自定义服务：控制台获得 https://<region>-<instance>.autodl.com 后填入
#   - 方案C frp：http://host.docker.internal:18080 或 http://<腾讯云公网IP>:18080
# BAGEL_AUTODL_SERVICE_URL=http://host.docker.internal:18080
# BAGEL_AUTODL_SERVICE_TOKEN=   # AutoDL 端 logs/api_key.txt 中的 Bearer Key（必填，勿提交到仓库）
# BAGEL_AUTODL_PROTOCOL=autodl_v1
# BAGEL_AUTODL_MODEL=sft_nf4    # sft_nf4(省显存/快) 或 sft_bf16(满血精度)；任务级可用 options.autodl_model 覆盖
# BAGEL_AUTODL_V1_TIMEOUT=300   # /v1/infer 单次超时秒
# BAGEL_AUTODL_HEALTH_TIMEOUT=8 # /health 探测超时秒
# ② 局域网本地机：BAGEL NF4 优化版（client_api/bagel_api.py，新版局域网 HTTP API，端口 6006）
#   - Windows 机无公网 IP，经 frp / SSH 反向隧道把 6006 映射到【云宿主机】；
#   - worker 在 Docker 容器内，容器里 127.0.0.1 是容器自身，须经宿主网关访问：
#     BAGEL_LOCAL_SERVICE_URL=http://host.docker.internal:6006
#     （docker-compose 已配置 extra_hosts: host.docker.internal:host-gateway）
#   - Tailscale 方案则填 Windows 机的 100.x 虚拟 IP：http://100.x.y.z:6006
#   - lan 协议支持图片理解；GPU 机装好 ffmpeg + faster-whisper 后，/health 会上报
#     transcribe / video_keyframes 能力，云端可派发 Whisper 转写与视频关键帧简述任务
#   - 详见 client_api/MAPS云端连接局域网BAGEL说明.md
# BAGEL_LOCAL_SERVICE_URL=http://host.docker.internal:6006
# BAGEL_LOCAL_SERVICE_TOKEN=   # Windows 端 logs/api_key.txt 中的 Bearer Key
# BAGEL_LOCAL_PROTOCOL=lan
# BAGEL_LAN_UNDERSTAND_TIMEOUT=300
# BAGEL_LAN_HEALTH_TIMEOUT=8
# 反馈#10：媒体端点（Whisper 转写 / 视频关键帧）超时与上传上限（长任务，默认 30 分钟 / 300MB）
# BAGEL_LAN_TRANSCRIBE_TIMEOUT=1800
# BAGEL_LAN_KEYFRAMES_TIMEOUT=1800
# BAGEL_LAN_MEDIA_MAX_MB=300    # GPU 机对应设置环境变量 BAGEL_MEDIA_MAX_BODY_MB

# 旧的单一推理端点（autodl/local 未配置时回落；一般无需改）
# BAGEL_SERVICE_URL=http://127.0.0.1:8000
# BAGEL_QUEUE_NAME=bagel:task:queue
# BAGEL_RESULT_TTL_SECONDS=86400
# BAGEL_SERVICE_TOKEN=
# BAGEL_FILE_TRANSFER=upload
# 外部worker下载云端文件的对外地址与共享Token（部署在autoDL/局域网的worker需要）
# MODEL_FILE_BASE_URL=https://maps.your-domain.com
# MODEL_FILE_TOKEN=

# DeepSeek API（OpenAI兼容，无需GPU；配额0=不限）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_DAILY_TOKEN_LIMIT=200000
# DEEPSEEK_MONTHLY_TOKEN_LIMIT=5000000

# ---------- 按人算力积分（DeepSeek token 与 GPU 算力统一计量）----------
# 总开关；注意：管理员尚未发放任何积分前系统自动不拦截，首次发放后开始预检扣减
# CREDIT_ENABLED=1
# DeepSeek 每 1000 token 消耗积分
# CREDIT_DEEPSEEK_PER_1K=1
# GPU 单次任务基础积分 + 每分钟媒体时长积分（autoDL 满血版按租用成本，local 优化版为沉没成本）
# CREDIT_AUTODL_BASE=10
# CREDIT_AUTODL_PER_MIN=3
# CREDIT_LOCAL_BASE=2
# CREDIT_LOCAL_PER_MIN=1
# 媒体时长未知时提交冻结的保守预估秒数
# CREDIT_EST_VIDEO_SECONDS=600
# CREDIT_EST_AUDIO_SECONDS=300
# 同文件（MD5）算法结果复用命中缓存是否免费（1=免费）
# CREDIT_CACHE_HIT_FREE=1
# 反馈#10：Whisper 转写（音/视频）= 基础积分 + 每分钟媒体时长积分
# CREDIT_TRANSCRIBE_BASE=1
# CREDIT_TRANSCRIBE_PER_MIN=1
# 反馈#10：BAGEL 视频关键帧简述 = 基础积分 + 每帧积分（默认每 8 秒 1 帧、单次最多 6 帧）
# CREDIT_KEYFRAMES_BASE=2
# CREDIT_KEYFRAMES_PER_FRAME=2
# CREDIT_KEYFRAME_INTERVAL_SEC=8
# CREDIT_KEYFRAME_MAX_FRAMES=6
# （外部大模型详细视频描述按 DeepSeek token 计量，单价同 CREDIT_DEEPSEEK_PER_1K）

# ---------- GPU 后端健康检查 / 故障自动切换 ----------
# GPU_HEALTH_TIMEOUT=5          # /health 探活超时秒数
# GPU_HEALTH_CACHE_SECONDS=60   # 探活结果 Redis 缓存秒数
# GPU_FAILOVER_ENABLED=1        # 首选 GPU 不健康时自动切到另一个已配置的 GPU 后端

# ---------- Worker 重试 / 死信 / 心跳 ----------
# BAGEL_MAX_ATTEMPTS=3            # 最大尝试次数（含首次），超过后进死信队列
# BAGEL_RETRY_BACKOFF_SECONDS=60  # 指数退避基数：60,120,240...
# BAGEL_WORKER_TTL_SECONDS=90     # worker 心跳 TTL，超时视为离线
# BAGEL_STUCK_QUEUED_SECONDS=600  # 排队超过该秒数无人消费→自动重投
# BAGEL_STUCK_RUNNING_SECONDS=1800  # 运行超过该秒数无心跳→判定失败并退款

# ---------- 登录限流（按 IP 固定窗口，防爆破）----------
# LOGIN_RATE_LIMIT_MAX=20         # 窗口内最大登录请求数
# LOGIN_RATE_WINDOW_SECONDS=300   # 窗口秒数

# ---------- 文件存储后端 ----------
# 注意：oss 目前为【预留扩展桩】，services/storage.py 已实现但上传/下载链路尚未接线，
#       设为 oss 不生效（文件仍写本地盘），正式启用前请勿配置。
# STORAGE_BACKEND=local           # local=本地磁盘（默认，当前唯一生效值）；oss=预留未启用
# OSS_ENDPOINT=
# OSS_BUCKET_NAME=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PUBLIC_BASE_URL=

# ---------- HTTPS ----------
# 启用域名 HTTPS 后设为 1（会话 Cookie 仅在 HTTPS 下传递）；配置模板见 deploy/nginx/maps-ssl.conf.example
# SESSION_COOKIE_SECURE=false

